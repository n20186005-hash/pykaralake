---
import '../styles/global.css';
import { ATTRACTION } from '../data/attraction';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  image = ATTRACTION.heroImage,
  imageAlt = `${ATTRACTION.fullName} in ${ATTRACTION.city}`,
  noindex = false
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const absoluteImage = Astro.site ? new URL(image, Astro.site).toString() : undefined;
const appTitle = `${ATTRACTION.fullName} (${ATTRACTION.shortName})`;
---
<!doctype html>
<html lang="ta-IN" data-lang="ta">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      /* 语言切换：在首屏绘制前应用已保存的偏好，避免闪烁 */
      (() => {
        try {
          if (localStorage.getItem('pykara-lang') === 'en') {
            const el = document.documentElement;
            el.setAttribute('data-lang', 'en');
            el.setAttribute('lang', 'en');
          }
        } catch (_) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183f33" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ta_IN" />
    <meta property="og:locale:alternate" content="en_IN" />
    <meta property="og:site_name" content={appTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content={appTitle} />
    <meta name="apple-mobile-web-app-title" content={ATTRACTION.shortName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="msapplication-TileColor" content="#183f33" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,inLanguage:['ta-IN','en']})} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <footer class="container-shell py-6 text-sm leading-7"><p class="ta-only">சுயாதீன, இலாப நோக்கற்ற சுற்றுலா மற்றும் அறிவியல் தகவல் வழிகாட்டி; TTDC அல்லது அரசின் அதிகாரப்பூர்வ தளம் அல்ல.</p><p class="en-only">Independent nonprofit tourism and educational guide; not an official TTDC or government website.</p><a href="/privacy/">Privacy</a> · <a href="/cookies/">Google Analytics preferences</a> · <a href="/">Home</a></footer>
    <a href="/privacy/" class="sr-only focus:not-sr-only">Privacy / தனியுரிமை</a>
    <div id="cookie-banner" class="fixed inset-x-4 bottom-4 z-[70] mx-auto hidden max-w-3xl rounded-3xl border border-white/30 bg-[#10251f]/95 p-5 text-white shadow-2xl backdrop-blur-xl">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <p class="text-sm leading-6 text-white/80 ta-only">விருப்ப Google Analytics உங்கள் ஒப்புதலுக்குப் பிறகே ஏற்றப்படும். Cloudflare சுயாதீன அணுகல்/செயல்திறன் அளவீட்டை தனியுரிமைப் பக்கத்தில் பார்க்கவும்.</p>
        <p class="text-sm leading-6 text-white/80 en-only">Optional Google Analytics loads after consent. Separate hosting/Cloudflare measurement is explained in Privacy.</p>
        <div class="flex shrink-0 flex-wrap gap-2">
          <button id="cookie-reject" class="rounded-full border border-white/25 px-4 py-2 text-sm font-bold ta-only">வேண்டாம்</button>
          <button id="cookie-reject-en" class="rounded-full border border-white/25 px-4 py-2 text-sm font-bold en-only">Decline</button>
          <button id="cookie-accept" class="rounded-full bg-white px-4 py-2 text-sm font-extrabold text-[#183f33] ta-only">ஒப்புக்கொள்</button>
          <button id="cookie-accept-en" class="rounded-full bg-white px-4 py-2 text-sm font-extrabold text-[#183f33] en-only">Accept</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (() => {
        const KEY = 'pykara-cookie-consent';
        const GA = 'G-HXM22WWPKP';
        const banner = document.getElementById('cookie-banner');
        const get = () => {try {return localStorage.getItem(KEY);} catch (_) {return null;}};
        /** @param {string} v */
        const put = (v) => {try {localStorage.setItem(KEY,v);} catch (_) {}};
        const loadGA = () => {
          window['ga-disable-G-HXM22WWPKP'] = false;
          if (document.querySelector('script[data-pykara-ga]')) return;
          const s=document.createElement('script');s.async=true;s.dataset.pykaraGa='1';
          s.src=`https://www.googletagmanager.com/gtag/js?id=${GA}`;document.head.appendChild(s);
          window.dataLayer=window.dataLayer||[];
          window.gtag=function(){window.dataLayer.push(arguments);};
          window.gtag('js',new Date());window.gtag('config',GA);
        };
        /** @param {string} v */
        const setChoice = (v) => {
          put(v);banner?.classList.add('hidden');
          if(v==='granted'){loadGA();return;}
          window['ga-disable-G-HXM22WWPKP']=true;
          for(const pair of document.cookie.split(';')){
            const name=pair.split('=')[0].trim();
            if(!/^_ga(?:_|$)/.test(name))continue;
            document.cookie=name+'=; Max-Age=0; path=/';
            for(const domain of [location.hostname,'.'+location.hostname.replace(/^www\./,'')])document.cookie=name+'=; Max-Age=0; path=/; domain='+domain;
          }
          if(document.querySelector('script[data-pykara-ga]'))location.reload();
        };
        const choice=get();
        if(choice==='granted')loadGA();else if(choice!=='denied')banner?.classList.remove('hidden');
        document.querySelectorAll('#cookie-accept, #cookie-accept-en').forEach(b=>b.addEventListener('click',()=>setChoice('granted')));
        document.querySelectorAll('#cookie-reject, #cookie-reject-en').forEach(b=>b.addEventListener('click',()=>setChoice('denied')));
        window.__pykaraConsent={key:KEY,loadGA,setChoice};
      })();
    </script>
    <script is:inline>
      // Register the legacy-cache retirement update; analytics consent is handled separately.
      (() => {
        if (!('serviceWorker' in navigator)) return;
        if (location.protocol !== 'https:') return;
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
        });
        window.__pykaraInstall = { deferred: null };
        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          if (window.__pykaraInstall) window.__pykaraInstall.deferred = e;
          document.querySelectorAll('[data-pwa-install]').forEach((el) => el.removeAttribute('hidden'));
        });
      })();
    </script>
    <script is:inline>
      // 语言切换：同页客户端切换（ta / en），localStorage 持久化
      (() => {
        const KEY = 'pykara-lang';
        const root = document.documentElement;
        /** @param {string} lang */
        const apply = (lang) => {
          const en = lang === 'en';
          root.setAttribute('data-lang', en ? 'en' : 'ta');
          root.setAttribute('lang', en ? 'en' : 'ta-IN');
          try { localStorage.setItem(KEY, en ? 'en' : 'ta'); } catch (_) {}
          document.querySelectorAll('[data-lang-toggle]').forEach((b) => {
            b.setAttribute('aria-pressed', String(en));
          });
        };
        const current = () => (root.getAttribute('data-lang') === 'en' ? 'en' : 'ta');
        document.querySelectorAll('[data-lang-toggle]').forEach((btn) => {
          btn.addEventListener('click', () => apply(current() === 'en' ? 'ta' : 'en'));
        });
      })();
    </script>
  </body>
</html>
