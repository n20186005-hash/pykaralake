---
import '../styles/global.css';
import { ATTRACTION } from '../data/attraction';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  image = ATTRACTION.heroImage,
  imageAlt = `${ATTRACTION.fullName} in ${ATTRACTION.city}`,
  noindex = false
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const absoluteImage = Astro.site ? new URL(image, Astro.site).toString() : undefined;
const appTitle = `${ATTRACTION.fullName} (${ATTRACTION.shortName})`;
---
<!doctype html>
<html lang="ta-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183f33" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ta_IN" />
    <meta property="og:locale:alternate" content="en_IN" />
    <meta property="og:site_name" content={appTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content={appTitle} />
    <meta name="apple-mobile-web-app-title" content={ATTRACTION.shortName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="msapplication-TileColor" content="#183f33" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <div id="cookie-banner" class="fixed inset-x-4 bottom-4 z-[70] mx-auto hidden max-w-3xl rounded-3xl border border-white/30 bg-[#10251f]/95 p-5 text-white shadow-2xl backdrop-blur-xl">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <p class="text-sm leading-6 text-white/80">அனலிட்டிக்ஸ் குக்கீகள் உங்கள் ஒப்புதலுக்கு பிறகே இயக்கப்படும். அத்தியாவசிய சேமிப்பு மட்டும் இயல்பாக பயன்படுத்தப்படுகிறது.</p>
        <div class="flex shrink-0 gap-2">
          <button id="cookie-reject" class="rounded-full border border-white/25 px-4 py-2 text-sm font-bold">வேண்டாம்</button>
          <button id="cookie-accept" class="rounded-full bg-white px-4 py-2 text-sm font-extrabold text-[#183f33]">ஒப்புக்கொள்</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (() => {
        const KEY = 'pykara-cookie-consent';
        const GA = 'G-HXM22WWPKP';
        const loadGA = () => {
          if (document.querySelector('script[data-pykara-ga]')) return;
          const s = document.createElement('script');
          s.async = true; s.dataset.pykaraGa = '1';
          s.src = `https://www.googletagmanager.com/gtag/js?id=${GA}`;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', GA, { anonymize_ip: true });
        };
        const choice = localStorage.getItem(KEY);
        const banner = document.getElementById('cookie-banner');
        if (choice === 'granted') loadGA();
        if (!choice && banner) banner.classList.remove('hidden');
        document.getElementById('cookie-accept')?.addEventListener('click', () => { localStorage.setItem(KEY,'granted'); banner?.classList.add('hidden'); loadGA(); });
        document.getElementById('cookie-reject')?.addEventListener('click', () => { localStorage.setItem(KEY,'denied'); banner?.classList.add('hidden'); });
        window.__pykaraConsent = { key: KEY, loadGA };
      })();
    </script>
    <script is:inline>
      // PWA: progressive enhancement only — offline app shell via /sw.js, never touched by analytics.
      (() => {
        if (!('serviceWorker' in navigator)) return;
        if (location.protocol !== 'https:') return;
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
        });
        window.__pykaraInstall = { deferred: null };
        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          if (window.__pykaraInstall) window.__pykaraInstall.deferred = e;
          document.querySelectorAll('[data-pwa-install]').forEach((el) => el.removeAttribute('hidden'));
        });
      })();
    </script>
  </body>
</html>
