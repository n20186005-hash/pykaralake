---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ATTRACTION, ratingText, reviewCountText, ratingPercent, googleReviewAttribution } from '../data/attraction';
import { getTopic, type TopicContent } from '../data/topics';

interface Props {
  topic: TopicContent;
}
const { topic } = Astro.props;
const site = Astro.site ?? new URL(ATTRACTION.siteUrl);
const url = (path = '/') => new URL(path, site).toString();
const selfUrl = url(`/${topic.slug}/`);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ATTRACTION.fullName, item: url('/') },
    { '@type': 'ListItem', position: 2, name: topic.h1.en, item: selfUrl }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topic.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q.en,
    acceptedAnswer: { '@type': 'Answer', text: f.a.en }
  }))
};
---

<BaseLayout
  title={topic.title.en}
  description={topic.description.en}
  image={topic.image}
  imageAlt={topic.imageAlt.en}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>

  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#0d2e26]/65 text-white backdrop-blur-xl">
    <div class="container-shell flex h-18 items-center justify-between gap-5 py-3">
      <a href="/" class="flex items-center gap-3 font-extrabold">
        <img src="/brand/logo.svg" alt="பைக்காரா லோகோ" class="h-11 w-11" />
        <span class="hidden sm:block">பைக்காரா <span class="text-white/55">நீலகிரி</span></span>
      </a>
      <nav class="hidden gap-6 text-sm font-bold text-white/80 xl:flex" aria-label="முதன்மை வழிசெலுத்தல்">
        <a href="/" class="hover:text-white"><span class="ta-only">முகப்பு</span><span class="en-only">Home</span></a>
        <a href="/#guides" class="hover:text-white"><span class="ta-only">வழிகாட்டிகள்</span><span class="en-only">Guides</span></a>
      </nav>
      <div class="flex items-center gap-2">
        <button type="button" data-lang-toggle aria-label="Switch language" class="lang-switch">
          <span class="ta-only">EN</span>
          <span class="en-only">தமிழ்</span>
        </button>
        <a class="rounded-full bg-white px-4 py-2 text-sm font-extrabold text-[#183f33]" href={ATTRACTION.mapsListingUrl} target="_blank" rel="noopener noreferrer"><span class="ta-only">வழி காண்க ↗</span><span class="en-only">Get directions ↗</span></a>
      </div>
    </div>
  </header>

  <main id="top">
    {/* HERO：名称 + 副标题 + 定位 + 方向链接 */}
    <section class="section bg-[#0d2e26] pt-28 text-white">
      <div class="container-shell">
        <nav class="breadcrumb breadcrumb-light" aria-label="Breadcrumb">
          <a href="/">{ATTRACTION.fullName}</a>
          <span class="sep" aria-hidden="true">→</span>
          <span aria-current="page">{topic.h1.en}</span>
        </nav>
        <h1 class="section-title mt-5 text-white"><span class="ta-only">{topic.h1.ta}</span><span class="en-only">{topic.h1.en}</span></h1>
        {topic.tagline && (
          <p class="mt-3 max-w-3xl text-lg font-bold text-[#d9a13a]">
            <span class="ta-only">{topic.tagline.ta}</span><span class="en-only">{topic.tagline.en}</span>
          </p>
        )}
        <p class="prose-copy mt-5 max-w-3xl text-white/80"><span class="ta-only">{topic.lead.ta}</span><span class="en-only">{topic.lead.en}</span></p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a class="btn-primary" href={ATTRACTION.mapsListingUrl} target="_blank" rel="noopener noreferrer">
            <span class="ta-only">Google Maps-இல் பார்க்க ↗</span><span class="en-only">View on Google Maps ↗</span>
          </a>
          <span class="pill border border-white/25"><span class="ta-only">புதுப்பிக்கப்பட்டது: {topic.updated}</span><span class="en-only">Last reviewed: {topic.updated}</span></span>
        </div>
      </div>
    </section>

    {/* 探索 / 引言 + 现有叙事区块（景区特色 / 关于 / 开放时间 / 门票 / 交通 / 发现魅力 / 游览须知 / 拍照 / 住宿） */}
    <section class="section">
      <div class="container-shell grid gap-10 lg:grid-cols-[1.1fr_.9fr]">
        <div>
          {topic.sections.map((s, i) => (
            <div class={i === 0 ? '' : 'mt-12'}>
              <h2 class="section-title text-[clamp(1.6rem,3vw,2.4rem)]" id={s.id}>
                <span class="ta-only">{s.heading.ta}</span><span class="en-only">{s.heading.en}</span>
              </h2>
              <p class="prose-copy mt-5"><span class="ta-only">{s.body.ta}</span><span class="en-only">{s.body.en}</span></p>
            </div>
          ))}
        </div>
        <figure class="relative overflow-hidden rounded-[2.3rem] shadow-2xl self-start">
          <img src={topic.image} alt={topic.imageAlt.en} class="aspect-[4/5] w-full object-cover" width="1600" height="1200" loading="lazy" />
        </figure>
      </div>
    </section>

    {/* 基础信息表 */}
    {topic.facts && topic.facts.length > 0 && (
      <section class="section bg-[#f7f2e7]">
        <div class="container-shell max-w-3xl">
          <p class="eyebrow"><span class="ta-only">அடிப்படைத் தகவல்</span><span class="en-only">At a glance</span></p>
          <h2 class="section-title mt-3 text-[clamp(1.6rem,3vw,2.4rem)]"><span class="ta-only">அடிப்படைத் தகவல் புள்ளிவிவரம்</span><span class="en-only">Quick facts</span></h2>
          <dl class="mt-8 divide-y divide-black/10 border-y border-black/10">
            {topic.facts.map((f) => (
              <div class="grid gap-2 py-4 sm:grid-cols-[200px_1fr] sm:gap-6">
                <dt class="font-extrabold text-[#183f33]"><span class="ta-only">{f.label.ta}</span><span class="en-only">{f.label.en}</span></dt>
                <dd class="text-[#3d514b]"><span class="ta-only">{f.value.ta}</span><span class="en-only">{f.value.en}</span></dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    {/* 游览路线（编号步骤） */}
    {topic.itinerary && topic.itinerary.length > 0 && (
      <section class="section">
        <div class="container-shell max-w-3xl">
          <p class="eyebrow"><span class="ta-only">பரிந்துரைக்கப்பட்ட பயணப் பாதை</span><span class="en-only">Suggested route</span></p>
          <h2 class="section-title mt-3 text-[clamp(1.6rem,3vw,2.4rem)]"><span class="ta-only">படிநிலை வழிகாட்டி</span><span class="en-only">Step-by-step route</span></h2>
          <ol class="mt-8 space-y-4">
            {topic.itinerary.map((step, i) => (
              <li class="flex gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#183f33] font-extrabold text-white">{i + 1}</span>
                <p class="prose-copy pt-1"><span class="ta-only">{step.ta}</span><span class="en-only">{step.en}</span></p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {/* 游客评价（区域 Google Maps 评分快照，不作伪原创） */}
    <section id="reviews" class="section bg-[#153b31] text-white">
      <div class="container-shell grid gap-10 lg:grid-cols-[.4fr_.6fr]">
        <div>
          <p class="eyebrow eyebrow-light"><span class="ta-only">பார்வையாளர் மதிப்பீடு</span><span class="en-only">Visitor rating</span></p>
          <h2 class="section-title mt-3"><span class="ta-only">பைக்காரா பகுதி மதிப்பீடு</span><span class="en-only">Pykara area rating</span></h2>
          <div class="mt-4 flex items-end gap-4">
            <strong class="font-serif text-6xl font-semibold leading-none">{ratingText}</strong>
            <div class="pb-1">
              <span class="rating-stars rating-stars-light text-xl" aria-hidden="true" role="img" aria-label={`${ratingText} / 5`}>
                <span style={`width:${ratingPercent}`}>★★★★★</span>★★★★★
              </span>
              <p class="mt-1 text-sm font-bold text-white/80">{reviewCountText} Google Maps reviews</p>
            </div>
          </div>
          <a class="btn-primary btn-google mt-6 w-full" href={ATTRACTION.mapsListingUrl} target="_blank" rel="noopener noreferrer">
            <span class="ta-only">{googleReviewAttribution.ctaTa} ↗</span><span class="en-only">{googleReviewAttribution.ctaEn} ↗</span>
          </a>
          <p class="mt-3 text-xs leading-5 text-white/60">
            <span class="ta-only">{googleReviewAttribution.inlineTa}</span><span class="en-only">{googleReviewAttribution.inlineEn}</span>
          </p>
        </div>
        <div class="card p-7 text-[#3d514b]">
          <p class="eyebrow"><span class="ta-only">மதிப்புரை மூலம்</span><span class="en-only">Review source</span></p>
          <p class="prose-copy mt-4 text-sm"><span class="ta-only">{googleReviewAttribution.blockTa}</span><span class="en-only">{googleReviewAttribution.blockEn}</span></p>
          <p class="mt-4 text-xs leading-5 text-[#65756f]">Google Maps™ and Google™ are trademarks of Google LLC. This independent guide is not affiliated with, endorsed by or sponsored by Google.</p>
        </div>
      </div>
    </section>

    {/* 交通指南：地址 + 地图链接 + 嵌入 */}
    <section id="transport-guide" class="section bg-[#edf2ed]">
      <div class="container-shell grid gap-10 lg:grid-cols-[.55fr_.45fr]">
        <div>
          <p class="eyebrow"><span class="ta-only">போக்குவரத்து வழிகாட்டி</span><span class="en-only">Getting here</span></p>
          <h2 class="section-title mt-3 text-[clamp(1.6rem,3vw,2.4rem)]"><span class="ta-only">முகவரி மற்றும் வரைபடம்</span><span class="en-only">Address &amp; map</span></h2>
          <p class="prose-copy mt-5"><span class="ta-only">முகவரி: {ATTRACTION.fullName}, {ATTRACTION.streetAddress}, {ATTRACTION.city}, {ATTRACTION.stateProvince}.</span><span class="en-only">Address: {ATTRACTION.fullName}, {ATTRACTION.streetAddress}, {ATTRACTION.city}, {ATTRACTION.stateProvince}.</span></p>
          <p class="prose-copy mt-4 text-sm"><span class="ta-only">{ATTRACTION.distanceFromOoty}.</span><span class="en-only">{ATTRACTION.distanceFromOoty}.</span></p>
          <a class="btn-primary mt-6" href={ATTRACTION.mapsListingUrl} target="_blank" rel="noopener noreferrer">
            <span class="ta-only">Google Maps இல் திற ↗</span><span class="en-only">Open in Google Maps ↗</span>
          </a>
        </div>
        <div class="overflow-hidden rounded-[2rem] border border-black/10 shadow-xl">
          <iframe
            title="Google Maps"
            class="h-80 w-full"
            src={ATTRACTION.mapsEmbedSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section id="faq" class="section bg-[#153b31] text-white">
      <div class="container-shell grid gap-10 lg:grid-cols-[.38fr_.62fr]">
        <div>
          <p class="eyebrow eyebrow-light">FAQ</p>
          <h2 class="section-title mt-3"><span class="ta-only">கேள்விகள்</span><span class="en-only">Frequently asked</span></h2>
        </div>
        <div>
          <div class="space-y-3 ta-only">
            {topic.faqs.map((f) => (
              <details class="rounded-2xl border border-white/10 bg-white/5 p-5 open:bg-white/10">
                <summary class="cursor-pointer list-none font-extrabold">{f.q.ta}</summary>
                <p class="mt-4 text-sm leading-7 text-white/65">{f.a.ta}</p>
              </details>
            ))}
          </div>
          <div class="space-y-3 en-only">
            {topic.faqs.map((f) => (
              <details class="rounded-2xl border border-white/10 bg-white/5 p-5 open:bg-white/10">
                <summary class="cursor-pointer list-none font-extrabold">{f.q.en}</summary>
                <p class="mt-4 text-sm leading-7 text-white/65">{f.a.en}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Related */}
    <section class="section bg-[#edf2ed]">
      <div class="container-shell">
        <p class="eyebrow"><span class="ta-only">மேலும் வழிகாட்டிகள்</span><span class="en-only">More Pykara guides</span></p>
        <h2 class="section-title mt-3 text-[clamp(1.6rem,3vw,2.4rem)]"><span class="ta-only">தொடர்புடைய வழிகாட்டிகள்</span><span class="en-only">Related guides</span></h2>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {topic.related.map((slug) => {
            const r = getTopic(slug);
            return r ? (
              <a href={`/${slug}/`} class="card p-5 hover:bg-white">
                <p class="font-extrabold text-lg"><span class="ta-only">{r.h1.ta}</span><span class="en-only">{r.h1.en}</span></p>
                <p class="mt-2 text-sm text-[#65756f]"><span class="ta-only">{r.lead.ta}</span><span class="en-only">{r.lead.en}</span></p>
              </a>
            ) : null;
          })}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
