---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ATTRACTION, ratingText, reviewCountText, ratingPercent, googleReviewAttribution } from '../data/attraction';
import { getTopic, type TopicContent } from '../data/topics';
import { PLACE_GUIDES } from '../data/placeGuides';
import { PLACE_GUIDES_TA } from '../data/placeGuidesTa';
import { PLACE_STORIES } from '../data/placeStories';

interface Props {
  topic: TopicContent;
}
const { topic } = Astro.props;
const site = Astro.site ?? new URL(ATTRACTION.siteUrl);
const url = (path = '/') => new URL(path, site).toString();
const selfUrl = url(`/${topic.slug}/`);
const place = PLACE_GUIDES[topic.slug];
const placeTa = PLACE_GUIDES_TA[topic.slug];
const story = PLACE_STORIES[topic.slug];
const displayImage = place?.photo ?? topic.image;
const locationUrl = place ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(topic.h1.en + ', Nilgiris, Tamil Nadu')}` : ATTRACTION.mapsListingUrl;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ATTRACTION.fullName, item: url('/') },
    { '@type': 'ListItem', position: 2, name: topic.h1.en, item: selfUrl }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topic.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q.en,
    acceptedAnswer: { '@type': 'Answer', text: f.a.en }
  }))
};
---

<BaseLayout
  title={topic.title.en}
  description={topic.description.en}
  image={displayImage}
  imageAlt={place ? topic.h1.en : topic.imageAlt.en}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>

  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#0d2e26]/65 text-white backdrop-blur-xl">
    <div class="container-shell flex h-18 items-center justify-between gap-5 py-3">
      <a href="/" class="flex items-center gap-3 font-extrabold">
        <img src="/brand/logo.svg" alt="பைக்காரா லோகோ" class="h-11 w-11" />
        <span class="hidden sm:block">பைக்காரா <span class="text-white/55">நீலகிரி</span></span>
      </a>
      <nav class="hidden gap-6 text-sm font-bold text-white/80 xl:flex" aria-label="முதன்மை வழிசெலுத்தல்">
        <a href="/" class="hover:text-white"><span class="ta-only">முகப்பு</span><span class="en-only">Home</span></a>
        <a href="/#guides" class="hover:text-white"><span class="ta-only">வழிகாட்டிகள்</span><span class="en-only">Guides</span></a>
      </nav>
      <div class="flex items-center gap-2">
        <button type="button" data-lang-toggle aria-label="Switch language" class="lang-switch">
          <span class="ta-only">EN</span>
          <span class="en-only">தமிழ்</span>
        </button>
        <a class="rounded-full bg-white px-4 py-2 text-sm font-extrabold text-[#183f33]" href={locationUrl} target="_blank" rel="noopener noreferrer"><span class="ta-only">வழி காண்க ↗</span><span class="en-only">Get directions ↗</span></a>
      </div>
    </div>
  </header>

  <main id="top">
    {/* HERO：名称 + 副标题 + 定位 + 方向链接 */}
    <section class="section bg-[#0d2e26] pt-28 text-white">
      <div class="container-shell">
        <nav class="breadcrumb breadcrumb-light" aria-label="Breadcrumb">
          <a href="/">{ATTRACTION.fullName}</a>
          <span class="sep" aria-hidden="true">→</span>
          <span aria-current="page">{topic.h1.en}</span>
        </nav>
        <h1 class="section-title mt-5 text-white"><span class="ta-only">{topic.h1.ta}</span><span class="en-only">{topic.h1.en}</span></h1>
        {topic.tagline && (
          <p class="mt-3 max-w-3xl text-lg font-bold text-[#d9a13a]">
            <span class="ta-only">{topic.tagline.ta}</span><span class="en-only">{topic.tagline.en}</span>
          </p>
        )}
        <p class="prose-copy mt-5 max-w-3xl text-white/80"><span class="ta-only">{topic.lead.ta}</span><span class="en-only">{topic.lead.en}</span></p>
        {place && <div class="mt-5 flex flex-wrap gap-3 text-sm"><a class="pill border border-white/25 hover:bg-white/10" href={locationUrl} target="_blank" rel="noopener noreferrer"><span class="ta-only">★ பயணிகள் மதிப்புரைகள் ↗</span><span class="en-only">★ Visitor reviews ↗</span></a><a class="pill border border-white/25 hover:bg-white/10" href="#hours-tickets-transport"><span class="ta-only">நேரம் மற்றும் கட்டணம் ↓</span><span class="en-only">Hours & tickets ↓</span></a></div>}
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a class="btn-primary" href={locationUrl} target="_blank" rel="noopener noreferrer">
            <span class="ta-only">Google Maps-இல் பார்க்க ↗</span><span class="en-only">View on Google Maps ↗</span>
          </a>
          <span class="pill border border-white/25"><span class="ta-only">புதுப்பிக்கப்பட்டது: {topic.updated}</span><span class="en-only">Last reviewed: {topic.updated}</span></span>
        </div>
      </div>
    </section>

    {story && <section class="section" id="explore-place"><div class="container-shell grid items-center gap-10 lg:grid-cols-[1.1fr_.9fr]"><div><p class="eyebrow"><span class="ta-only">இந்த இடத்தை அறியுங்கள்</span><span class="en-only">Explore the destination</span></p><h2 class="section-title mt-3"><span class="ta-only">{topic.h1.ta} – கண்டறியுங்கள்</span><span class="en-only">Discover {topic.h1.en}</span></h2><p class="prose-copy mt-6"><span class="ta-only">{story.taIntro}</span><span class="en-only">{story.intro}</span></p><p class="prose-copy mt-5"><span class="ta-only">{placeTa?.[3]}</span><span class="en-only">{place?.experience}</span></p></div><figure class="overflow-hidden rounded-[2rem] shadow-xl"><img src={displayImage} alt={topic.h1.en} class="aspect-[5/4] w-full object-cover" loading="eager" width="1280" height="960" /><figcaption class="bg-[#153b31] px-4 py-2 text-xs text-white/80">{place?.credit}</figcaption></figure></div></section>}

    {place && <section class="section bg-[#f7f2e7]" id="visit-advice">
      <div class="container-shell grid gap-8 lg:grid-cols-2">
        <div><p class="eyebrow">Visit planning</p><h2 class="section-title mt-3 text-[clamp(1.5rem,3vw,2.2rem)]"><span class="ta-only">பயண ஆலோசனைகள்</span><span class="en-only">Visit tips</span></h2><p class="prose-copy mt-4"><span class="ta-only">{placeTa?.[0]}</span><span class="en-only">{place.tip}</span></p></div>
        <div><p class="eyebrow">Highlights</p><h2 class="section-title mt-3 text-[clamp(1.5rem,3vw,2.2rem)]"><span class="ta-only">முக்கிய அம்சங்கள்</span><span class="en-only">Scenic highlights</span></h2><p class="prose-copy mt-4"><span class="ta-only">{placeTa?.[1]}</span><span class="en-only">{place.highlight}</span></p></div>
      </div>
    </section>}

    {/* 探索 / 引言 + 现有叙事区块（景区特色 / 关于 / 开放时间 / 门票 / 交通 / 发现魅力 / 游览须知 / 拍照 / 住宿） */}
    {!place && <section class="section">
      <div class="container-shell grid gap-10 lg:grid-cols-[1.1fr_.9fr]">
        <div>
          {topic.sections.map((s, i) => (
            <div class={i === 0 ? '' : 'mt-12'}>
              <h2 class="section-title text-[clamp(1.6rem,3vw,2.4rem)]" id={s.id}>
                <span class="ta-only">{s.heading.ta}</span><span class="en-only">{s.heading.en}</span>
              </h2>
              <p class="prose-copy mt-5"><span class="ta-only">{s.body.ta}</span><span class="en-only">{s.body.en}</span></p>
            </div>
          ))}
        </div>
        <figure class="relative overflow-hidden rounded-[2.3rem] shadow-2xl self-start">
          <img src={displayImage} alt={topic.imageAlt.en} class="aspect-[4/5] w-full object-cover" width="1600" height="1200" loading="lazy" />
        </figure>
      </div>
    </section>}

    {story && <section class="section" id="about-place"><div class="container-shell max-w-4xl"><p class="eyebrow"><span class="ta-only">இந்த இடத்தைப் பற்றி</span><span class="en-only">About the attraction</span></p><h2 class="section-title mt-3"><span class="ta-only">{topic.h1.ta} – வரலாறும் பின்னணியும்</span><span class="en-only">About {topic.h1.en}</span></h2><p class="prose-copy mt-6"><span class="ta-only">{story.taHistory}</span><span class="en-only">{story.history}</span></p><p class="prose-copy mt-5"><span class="ta-only">{placeTa?.[2]}</span><span class="en-only">{place?.about}</span></p></div></section>}

    {/* 基础信息表 */}
    {topic.facts && topic.facts.length > 0 && (
      <section class="section bg-[#f7f2e7]">
        <div class="container-shell max-w-3xl">
          <p class="eyebrow"><span class="ta-only">அடிப்படைத் தகவல்</span><span class="en-only">At a glance</span></p>
          <h2 class="section-title mt-3 text-[clamp(1.6rem,3vw,2.4rem)]"><span class="ta-only">அடிப்படைத் தகவல் புள்ளிவிவரம்</span><span class="en-only">Quick facts</span></h2>
          <dl class="mt-8 divide-y divide-black/10 border-y border-black/10">
            {topic.facts.map((f) => (
              <div class="grid gap-2 py-4 sm:grid-cols-[200px_1fr] sm:gap-6">
                <dt class="font-extrabold text-[#183f33]"><span class="ta-only">{f.label.ta}</span><span class="en-only">{f.label.en}</span></dt>
                <dd class="text-[#3d514b]"><span class="ta-only">{f.value.ta}</span><span class="en-only">{f.value.en}</span></dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    {place && <section class="section bg-[#edf2ed]" id="hours-tickets-transport">
      <div class="container-shell grid gap-5 md:grid-cols-3">
        <article class="card p-6"><p class="eyebrow"><span class="ta-only">பயண நேரம்</span><span class="en-only">Plan your visit</span></p><h2 class="mt-2 text-xl font-bold"><span class="ta-only">திறப்பு நேரம்</span><span class="en-only">Opening hours</span></h2><p class="prose-copy mt-3"><span class="ta-only">இடம் மற்றும் பருவத்தைப் பொறுத்து நுழைவு நேரம் மாறலாம். அன்றைய நுழைவு நேரத்தை வரைபடப் பட்டியல் அல்லது உள்ளூர் அறிவிப்பில் பார்க்கவும்.</span><span class="en-only">Visiting windows vary by location and season. See the attraction’s map listing or entrance notice when planning your day.</span></p><a class="mt-4 inline-block font-bold text-[#183f33] underline" href={locationUrl} target="_blank" rel="noopener noreferrer"><span class="ta-only">இடத்தைப் பார்க்க ↗</span><span class="en-only">View location ↗</span></a></article>
        <article class="card p-6"><p class="eyebrow"><span class="ta-only">செலவுகள்</span><span class="en-only">Admission</span></p><h2 class="mt-2 text-xl font-bold"><span class="ta-only">நுழைவுக் கட்டணம்</span><span class="en-only">Ticket prices</span></h2><p class="prose-copy mt-3"><span class="ta-only">நுழைவு, வாகன நிறுத்தம், வழிகாட்டி அல்லது பயண முன்பதிவு ஆகியவை இடத்துக்கு ஏற்ப வேறுபடும். பயணத்திற்கு முன் பொருந்தும் கட்டண வகையைத் தேர்வு செய்யவும்.</span><span class="en-only">Entry, parking, guided visits and advance bookings are separate considerations. Choose the services relevant to your itinerary and check the posted rates.</span></p></article>
        <article class="card p-6"><p class="eyebrow"><span class="ta-only">செல்லும் வழி</span><span class="en-only">Getting there</span></p><h2 class="mt-2 text-xl font-bold"><span class="ta-only">போக்குவரத்து</span><span class="en-only">Transport options</span></h2><p class="prose-copy mt-3"><span class="ta-only">ஊட்டியிலிருந்து சாலை வழி, உள்ளூர் வாகனம் அல்லது கிடைக்கும் பொதுப் போக்குவரத்தைப் பயன்படுத்தலாம். தொலைதூர வனப் பகுதிகளில் முன் அனுமதி தேவைப்படலாம்.</span><span class="en-only">Travel from Ooty by the suitable road route, local vehicle or available public transport. Remote forest areas may require an arranged excursion or access permit.</span></p></article>
      </div>
    </section>}

    {story && <section class="section" id="discover-place"><div class="container-shell"><p class="eyebrow"><span class="ta-only">இடத்தின் சிறப்பு</span><span class="en-only">Discover the appeal</span></p><h2 class="section-title mt-3"><span class="ta-only">இயற்கை, நில அமைப்பு மற்றும் அனுபவம்</span><span class="en-only">Landscape, heritage & core experiences</span></h2><div class="mt-8 grid gap-10 lg:grid-cols-[.9fr_1.1fr]"><div class="rounded-[2rem] bg-[#f7f2e7] p-7"><h3 class="text-2xl font-bold"><span class="ta-only">இயற்கைக் காட்சி</span><span class="en-only">Nature & landscape</span></h3><p class="prose-copy mt-4"><span class="ta-only">{story.taLandscape}</span><span class="en-only">{story.landscape}</span></p><h3 class="mt-7 text-2xl font-bold"><span class="ta-only">முக்கிய அனுபவம்</span><span class="en-only">Signature experience</span></h3><p class="prose-copy mt-4"><span class="ta-only">{story.taVisit}</span><span class="en-only">{story.visit}</span></p></div><div class="space-y-7">{topic.sections.map((s)=><article><h3 class="text-xl font-extrabold"><span class="ta-only">{s.heading.ta}</span><span class="en-only">{s.heading.en}</span></h3><p class="prose-copy mt-3"><span class="ta-only">{s.body.ta}</span><span class="en-only">{s.body.en}</span></p></article>)}</div></div></div></section>}

    {/* 游览路线（编号步骤） */}
    {topic.itinerary && topic.itinerary.length > 0 && (
      <section class="section">
        <div class="container-shell max-w-3xl">
          <p class="eyebrow"><span class="ta-only">பரிந்துரைக்கப்பட்ட பயணப் பாதை</span><span class="en-only">Suggested route</span></p>
          <h2 class="section-title mt-3 text-[clamp(1.6rem,3vw,2.4rem)]"><span class="ta-only">படிநிலை வழிகாட்டி</span><span class="en-only">Step-by-step route</span></h2>
          <ol class="mt-8 space-y-4">
            {topic.itinerary.map((step, i) => (
              <li class="flex gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#183f33] font-extrabold text-white">{i + 1}</span>
                <p class="prose-copy pt-1"><span class="ta-only">{step.ta}</span><span class="en-only">{step.en}</span></p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {place && <section class="section bg-[#f7f2e7]" id="visitor-tips"><div class="container-shell"><div class="grid gap-6 lg:grid-cols-3"><article class="card p-7"><p class="eyebrow"><span class="ta-only">புறப்படுவதற்கு முன்</span><span class="en-only">Before you go</span></p><h2 class="mt-3 text-2xl font-bold"><span class="ta-only">பயண அறிவுறுத்தல்கள்</span><span class="en-only">Visitor essentials</span></h2><p class="prose-copy mt-5"><span class="ta-only">{placeTa?.[4]}</span><span class="en-only">{place.caution}</span></p><p class="prose-copy mt-4"><span class="ta-only">{placeTa?.[7]}</span><span class="en-only">{place.tip}</span></p></article><article class="card p-7"><p class="eyebrow"><span class="ta-only">படப்பிடிப்பு</span><span class="en-only">Photography</span></p><h2 class="mt-3 text-2xl font-bold"><span class="ta-only">புகைப்பட இடங்கள்</span><span class="en-only">Best photo angles</span></h2><p class="prose-copy mt-5"><span class="ta-only">{placeTa?.[5]}</span><span class="en-only">{place.photoTip}</span></p><p class="prose-copy mt-4"><span class="ta-only">{story?.taLandscape}</span><span class="en-only">{story?.landscape}</span></p></article><article class="card p-7"><p class="eyebrow"><span class="ta-only">சுற்றுலா தளம்</span><span class="en-only">Travel base</span></p><h2 class="mt-3 text-2xl font-bold"><span class="ta-only">தங்குமிட ஆலோசனை</span><span class="en-only">Where to stay</span></h2><p class="prose-copy mt-5"><span class="ta-only">{placeTa?.[6]}</span><span class="en-only">{place.stay}</span></p><p class="prose-copy mt-4"><span class="ta-only">பயண வழியைப் பொறுத்து ஊட்டி மற்றும் அருகிலுள்ள நகரங்களில் தங்குமிடத்தைத் தேர்வு செய்யலாம்.</span><span class="en-only">Choose accommodation around your route and travel pace; Ooty is a convenient base for many of these destinations.</span></p></article></div></div></section>}

    {/* 游客评价（区域 Google Maps 评分快照，不作伪原创） */}
    <section id="reviews" class="section bg-[#153b31] text-white">
      <div class="container-shell grid gap-10 lg:grid-cols-[.4fr_.6fr]">
        <div>
          <p class="eyebrow eyebrow-light"><span class="ta-only">பார்வையாளர் மதிப்பீடு</span><span class="en-only">Visitor rating</span></p>
          <h2 class="section-title mt-3"><span class="ta-only">{place ? 'இந்த இடத்தின் பயணிகள் கருத்துகள்' : 'பைக்காரா பகுதி மதிப்பீடு'}</span><span class="en-only">{place ? 'Visitor reviews for this place' : 'Pykara area rating'}</span></h2>
          {place ? <p class="prose-copy mt-5 text-white/80"><span class="ta-only">மற்ற பயணிகளின் அண்மைய அனுபவங்கள், புகைப்படங்கள் மற்றும் பயணக் குறிப்புகளை Google Maps-இல் பாருங்கள். பருவம் மற்றும் வானிலைக்கு ஏற்ப அனுபவம் மாறும்.</span><span class="en-only">Read recent visitor impressions, browse real trip photos and compare tips for different seasons on Google Maps. The experience can change with weather, access and time of day.</span></p> : <>
          <div class="mt-4 flex items-end gap-4">
            <strong class="font-serif text-6xl font-semibold leading-none">{ratingText}</strong>
            <div class="pb-1">
              <span class="rating-stars rating-stars-light text-xl" aria-hidden="true" role="img" aria-label={`${ratingText} / 5`}>
                <span style={`width:${ratingPercent}`}>★★★★★</span>★★★★★
              </span>
              <p class="mt-1 text-sm font-bold text-white/80">{reviewCountText} Google Maps reviews</p>
            </div>
          </div>
          </>}
          <a class="btn-primary btn-google mt-6 w-full" href={locationUrl} target="_blank" rel="noopener noreferrer">
            <span class="ta-only">{googleReviewAttribution.ctaTa} ↗</span><span class="en-only">{googleReviewAttribution.ctaEn} ↗</span>
          </a>
          {!place && <p class="mt-3 text-xs leading-5 text-white/60">
            <span class="ta-only">{googleReviewAttribution.inlineTa}</span><span class="en-only">{googleReviewAttribution.inlineEn}</span>
          </p>}
        </div>
        <div class="card p-7 text-[#3d514b]">
          <p class="eyebrow"><span class="ta-only">மதிப்புரை மூலம்</span><span class="en-only">Review source</span></p>
          <p class="prose-copy mt-4 text-sm">{place ? <><span class="ta-only">புகைப்படங்களில் காணும் நிலப்பரப்பு, நடைபாதை நிலை, கூட்டம் மற்றும் போக்குவரத்து அனுபவங்களை ஒப்பிட்டுப் பாருங்கள். உங்கள் பயணத்திற்கான சிறந்த நேரத்தையும் வழியையும் தீர்மானிக்க இது உதவும்.</span><span class="en-only">Look at recent photos of the landscape, paths and visitor facilities. Compare comments about crowds, road approaches and visibility to shape a more comfortable visit.</span></> : <><span class="ta-only">{googleReviewAttribution.blockTa}</span><span class="en-only">{googleReviewAttribution.blockEn}</span></>}</p>
          {!place && <p class="mt-4 text-xs leading-5 text-[#65756f]">Google Maps™ and Google™ are trademarks of Google LLC. This independent guide is not affiliated with, endorsed by or sponsored by Google.</p>}
        </div>
      </div>
    </section>

    {/* 交通指南：地址 + 地图链接 + 嵌入 */}
    <section id="transport-guide" class="section bg-[#edf2ed]">
      <div class="container-shell grid gap-10 lg:grid-cols-[.55fr_.45fr]">
        <div>
          <p class="eyebrow"><span class="ta-only">போக்குவரத்து வழிகாட்டி</span><span class="en-only">Getting here</span></p>
          <h2 class="section-title mt-3 text-[clamp(1.6rem,3vw,2.4rem)]"><span class="ta-only">முகவரி மற்றும் வரைபடம்</span><span class="en-only">Address &amp; map</span></h2>
          {place ? <><p class="prose-copy mt-5"><span class="ta-only">{topic.h1.ta}, நீலகிரி மாவட்டம், தமிழ்நாடு, இந்தியா.</span><span class="en-only">{topic.h1.en}, Nilgiris district, Tamil Nadu, India.</span></p><p class="prose-copy mt-4 text-sm"><span class="ta-only">பயணத்திற்கு முன் வரைபடத்தில் நுழைவிடம், சாலை வழி மற்றும் அருகிலுள்ள நிறுத்துமிடங்களைப் பாருங்கள்.</span><span class="en-only">Open the place listing for the approach road, entrance area and nearby stopping points before setting out.</span></p></> : <><p class="prose-copy mt-5"><span class="ta-only">முகவரி: {ATTRACTION.fullName}, {ATTRACTION.streetAddress}, {ATTRACTION.city}, {ATTRACTION.stateProvince}.</span><span class="en-only">Address: {ATTRACTION.fullName}, {ATTRACTION.streetAddress}, {ATTRACTION.city}, {ATTRACTION.stateProvince}.</span></p><p class="prose-copy mt-4 text-sm"><span class="ta-only">{ATTRACTION.distanceFromOoty}.</span><span class="en-only">{ATTRACTION.distanceFromOoty}.</span></p></>}
          <a class="btn-primary mt-6" href={locationUrl} target="_blank" rel="noopener noreferrer">
            <span class="ta-only">Google Maps இல் திற ↗</span><span class="en-only">Open in Google Maps ↗</span>
          </a>
        </div>
        {place ? <div class="overflow-hidden rounded-[2rem] border border-black/10 bg-[#dce8dc] p-8 shadow-xl"><h3 class="text-xl font-bold"><span class="ta-only">{topic.h1.ta}</span><span class="en-only">{topic.h1.en}</span></h3><p class="mt-4 text-[#3d514b]"><span class="ta-only">ஊட்டியிலிருந்து இந்த இடத்திற்கான பயண வழியைத் திட்டமிடுங்கள். வழியில் பிற நீலகிரி சுற்றுலா இடங்களையும் இணைக்கலாம்.</span><span class="en-only">Plan your route from Ooty and save the place on your map. Nearby Nilgiri stops can be combined into a relaxed excursion.</span></p><a class="btn-primary mt-6 inline-block" href={locationUrl} target="_blank" rel="noopener noreferrer"><span class="ta-only">வரைபடத்தில் பார்க்க ↗</span><span class="en-only">View this place on Google Maps ↗</span></a></div> : <div class="overflow-hidden rounded-[2rem] border border-black/10 shadow-xl">
          <iframe
            title="Google Maps"
            class="h-80 w-full"
            src={ATTRACTION.mapsEmbedSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>}
      </div>
    </section>

    {/* FAQ */}
    <section id="faq" class="section bg-[#153b31] text-white">
      <div class="container-shell grid gap-10 lg:grid-cols-[.38fr_.62fr]">
        <div>
          <p class="eyebrow eyebrow-light">FAQ</p>
          <h2 class="section-title mt-3"><span class="ta-only">கேள்விகள்</span><span class="en-only">Frequently asked</span></h2>
        </div>
        <div>
          <div class="space-y-3 ta-only">
            {topic.faqs.map((f) => (
              <details class="rounded-2xl border border-white/10 bg-white/5 p-5 open:bg-white/10">
                <summary class="cursor-pointer list-none font-extrabold">{f.q.ta}</summary>
                <p class="mt-4 text-sm leading-7 text-white/65">{f.a.ta}</p>
              </details>
            ))}
          </div>
          <div class="space-y-3 en-only">
            {topic.faqs.map((f) => (
              <details class="rounded-2xl border border-white/10 bg-white/5 p-5 open:bg-white/10">
                <summary class="cursor-pointer list-none font-extrabold">{f.q.en}</summary>
                <p class="mt-4 text-sm leading-7 text-white/65">{f.a.en}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Related */}
    <section class="section bg-[#edf2ed]">
      <div class="container-shell">
        <p class="eyebrow"><span class="ta-only">மேலும் வழிகாட்டிகள்</span><span class="en-only">More Pykara guides</span></p>
        <h2 class="section-title mt-3 text-[clamp(1.6rem,3vw,2.4rem)]"><span class="ta-only">தொடர்புடைய வழிகாட்டிகள்</span><span class="en-only">Related guides</span></h2>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {topic.related.map((slug) => {
            const r = getTopic(slug);
            return r ? (
              <a href={`/${slug}/`} class="card p-5 hover:bg-white">
                <p class="font-extrabold text-lg"><span class="ta-only">{r.h1.ta}</span><span class="en-only">{r.h1.en}</span></p>
                <p class="mt-2 text-sm text-[#65756f]"><span class="ta-only">{r.lead.ta}</span><span class="en-only">{r.lead.en}</span></p>
              </a>
            ) : null;
          })}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
