  <script is:inline>
    document.getElementById('save-plan')?.addEventListener('click', () => {
      try { localStorage.setItem('pykara-saved-plan', JSON.stringify({ savedAt: new Date().toISOString(), stops: ['Confirm TTDC date and boat type', 'Check Pykara Falls separately', 'Arrange return transport'] })); } catch (_) { return; }
      const button = document.getElementById('save-plan');
      if (button) button.innerHTML = '<span class="ta-only">சேமிக்கப்பட்டது ✓</span><span class="en-only">Saved ✓</span>';
    });
    document.querySelector('[data-pwa-install]')?.addEventListener('click', async () => {
      const install = window.__pykaraInstall;
      const deferred = install?.deferred;
      if (!install || !deferred || typeof deferred.prompt !== 'function') return;
      deferred.prompt();
      await deferred.userChoice;
      install.deferred = null;
      document.querySelector('[data-pwa-install]')?.setAttribute('hidden', '');
    });
  </script>
