---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntityGuide from '../components/EntityGuide.astro';
import RatingChip from '../components/RatingChip.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import SourcesSection from '../components/SourcesSection.astro';
import { ATTRACTION } from '../data/attraction';

/* ------------------------------------------------------------------ *
 * TDK / OG —— 单景点实体绑定（全称 + 城市 + 域名含义）
 * 覆盖高意图英文查询：pykara lake boat house / boating in ooty /
 * pykara waterfalls / timings / ticket price / how to reach from Ooty
 * ------------------------------------------------------------------ */
const title = "Pykara Lake Boat House, Ooty – Timings, Tickets & 2026 Rules";
const description = "Plan your visit to Pykara Lake Boat House near Ooty. Check the updated 2026 boating restrictions, visitor hours, ticket information, directions and nearby attractions.";

const site = Astro.site ?? new URL(ATTRACTION.siteUrl);
const url = (path = '/') => new URL(path, site).toString();

/* ------------------------------------------------------------------ *
 * 2. 结构化数据：TouristAttraction（补全 @id / image / geo / address）
 *    注意：Google 评分与评价数只做页面展示，绝不写入 JSON-LD。
 * ------------------------------------------------------------------ */
const touristSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${url('/')}#attraction`,
  name: ATTRACTION.fullName,
  alternateName: [
    ATTRACTION.shortName,
    `${ATTRACTION.city} ${ATTRACTION.fullName}`,
    ATTRACTION.localizedName
  ],
  description: `Comprehensive visitor guide to ${ATTRACTION.fullName} in ${ATTRACTION.city}, ${ATTRACTION.stateProvince}, ${ATTRACTION.country}.`,
  url: url('/'),
  image: ATTRACTION.images.map((image) => url(image)),
  address: {
    '@type': 'PostalAddress',
    streetAddress: ATTRACTION.subLocality,
    addressLocality: ATTRACTION.city,
    addressRegion: ATTRACTION.stateProvince,
    addressCountry: ATTRACTION.countryCode2
  },
  hasMap: ATTRACTION.mapsShareUrl,
  sameAs: [ATTRACTION.mapsShareUrl],
  touristType: ATTRACTION.touristType,
  containedInPlace: {
    '@type': 'TouristDestination',
    name: `${ATTRACTION.district}, ${ATTRACTION.stateProvince}, ${ATTRACTION.country}`
  }
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${url('/')}#website`,
  url: url('/'),
  name: `${ATTRACTION.fullName} - ${ATTRACTION.shortName} visitor guide`,
  inLanguage: ['ta-IN', 'en'],
  about: { '@id': `${url('/')}#attraction` }
};

/* 4.2 地理面包屑与归属层级 */
const breadcrumbSchema = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:ATTRACTION.fullName,item:url('/')} ]};

/* ------------------------------------------------------------------ *
 * FAQPage（5~8 条以上常问问题；不含任何评分/评价结构化数据）
 * ------------------------------------------------------------------ */
const faqsTa: Array<[string,string]> = [
 ['படகு இல்லத்தின் தற்போதைய நேரம் என்ன?','நடப்பு அதிகாரப்பூர்வ தினசரி அட்டவணை இங்கே உறுதிப்படுத்தப்படவில்லை. 2026-10-29 Google Maps பதிவு அன்று 17:30 மூடுவதாகக் காட்டியது; அது தினசரி இயக்குநர் நேரமல்ல. புறப்படுவதற்கு முன் TTDC-யிடம் முதல்/கடைசி படகு மற்றும் டிக்கெட் நேரத்தை உறுதி செய்யவும்.'],
 ['நுழைவு மற்றும் படகு கட்டணம் எவ்வளவு?','நடப்பு கட்டணப்பட்டியல் உறுதிப்படுத்தப்படவில்லை. TTDC அதிகாரப்பூர்வ முன்பதிவு தளத்தில் பயண தேதி, Pykara படகு இல்லம் மற்றும் படகு வகையைத் தேர்ந்தெடுத்து இறுதி விலை மற்றும் கிடைப்பைச் சரிபார்க்கவும். நுழைவு, வாகனம் அல்லது பிற தனிக் கட்டணங்கள் உள்ளதா என்று கேட்கவும்.'],
 ['சக்கர நாற்காலியில் செல்ல முடியுமா?','ஒருங்கிணைப்பாளர் பார்த்த Google Maps பட்டியல் அணுகக்கூடிய நுழைவாயில் இல்லை எனக் குறிப்பிட்டது. இது மூன்றாம் தரப்பு பதிவு; நேரடி அணுகல் ஆய்வு அல்ல. வாகனம் இறக்கும் இடம் முதல் படகு ஏறும் தளம் வரை படிகள், சரிவு, கழிப்பறை மற்றும் உதவி பற்றி TTDC-யிடம் முன்கூட்டியே கேட்கவும்.'],
 ['பைக்காரா ஏரியும் நீர்வீழ்ச்சியும் ஒரே இடமா?','இல்லை. ஏரி படகு இல்லமும் பைக்காரா நீர்வீழ்ச்சி பார்வைப் பகுதியும் தனித்தனி இடங்கள். இரண்டின் நுழைவு, நேரம், போக்குவரத்து மற்றும் திறந்த நிலையைத் தனித்தனியாக உறுதி செய்யவும். தடைகளைத் தாண்டவோ நீரில் இறங்கவோ வேண்டாம்.'],
 ['படகு தினமும் கிடைக்குமா?','குறிப்பிட்ட தேதியில் படகு அல்லது வேகப்படகு கிடைப்பதை இத்தளம் உறுதி செய்யாது. TTDC-யிடம் இருக்கைகள், படகு வகை, பாதுகாப்பு உபகரணங்கள் மற்றும் வானிலை ரத்து/திருப்பித் தரும் விதிகளைச் சரிபார்க்கவும்.'],
 ['ஊட்டியிலிருந்து எப்படி செல்லலாம்?','நீலகிரி மாவட்ட சுற்றுலாப் பக்கம் ஏரியை ஊட்டியிலிருந்து சுமார் 21 கி.மீ., ஊட்டி–மைசூர் சாலையில் குறிப்பிடுகிறது. அது துல்லியமான பயண நேரமல்ல. உங்கள் தொடக்க இடத்திலிருந்து பாதை, சரியான படகு இல்ல நுழைவு மற்றும் திரும்பும் போக்குவரத்தை உறுதி செய்யவும்.'],
  ['2026 பைக்காரா ஏரி நீதிமன்ற உத்தரவில் என்ன மாற்றம்?','2026 அக்டோபர் 30 அன்று சென்னை உயர் நீதிமன்ற உத்தரவு சில கட்டுப்பாடுகளை நிலையானவையாக்கியது: பெட்ரோல்/டீசல் மோட்டார் படகுகள், வேகப்படகுகள் மற்றும் ஜெட் ஸ்கிக்கள் தடைசெய்யப்பட்டன; பார்வையாளர் நேரம் 10:00–16:00; தினசரி வருகை வரம்புகள், மேலாண்மை முன்பதிவு மற்றும் கட்டுப்படுத்தப்பட்ட படகு இயக்கம் பொருந்தும். படகு வலிக்கும், மிதவைப் படகும் மற்றும் குறைந்த திறன் மின்சாரப் படகுகள் நிபந்தனைகளின் கீழ் அனுமதிக்கப்படலாம். இந்த உத்தரவு அனைத்துப் படகு வகைகளுக்கும் டிக்கெட் விற்பனை நடப்பதை உறுதி செய்யாது — இயக்க நிலை, கட்டணம் மற்றும் முன்பதிவு வழியை TTDC-யிடம் உறுதி செய்யவும். அடுத்த நீதிமன்ற முன்னேற்ற அறிக்கை 2026 டிசம்பர் 4 அன்று திட்டமிடப்பட்டுள்ளது.'],
];
const faqsEn: Array<[string,string]> = [
 ['What are the Pykara Lake Boat House timings?','On 30 October 2026 the Madras High Court set Pykara Lake’s visitor window at 10:00–16:00 and ordered daily visitor-capacity limits with managed booking and controlled boat operations. Treat 10:00–16:00 as the court-ordered visitor window, not a guaranteed ticket-counter timetable; ask TTDC about counter opening, the last sailing and operation for your date. Older 8:30–17:30 or 17:30 closing times from past tourism material are not shown here as current.'],
 ['What is the Pykara boating ticket price?','No current fare table has been verified for this guide. The 2026 court ruling restricts which boats may operate, so older Pykara or Ooty Boat House fares are not a reliable current price. Use the official TTDC booking portal, select Pykara, your date and an allowed boat type, and read the final quoted price and availability. Ask whether admission, vehicle charges, taxes or other fees are separate.'],
 ['What changed under the 2026 Pykara Lake court ruling?','The Madras High Court order of 30 October 2026 made several restrictions standing: petrol/diesel motorboats, speed boats and jet skis are banned; the visitor window is 10:00–16:00; and daily visitor caps, managed booking and controlled boat operations apply. Rowing, pedal and low-power electric boats may be allowed under conditions. The order does not by itself mean tickets are on sale for every boat type — confirm the operating status, fares and booking channel with TTDC. The next court progress report is scheduled for 4 December 2026.'],
 ['Is Pykara Lake Boat House wheelchair accessible?','The 29 October 2026 Google Maps listing snapshot reported no accessible entrance. This is a third-party listing observation, not an access survey. Ask TTDC about the complete route from drop-off to jetty, steps, gradients, toilets, boarding assistance and your specific needs before relying on access.'],
 ['Are Pykara Lake, Ooty Boat House and Pykara Falls the same place?','No. This guide concerns Pykara Lake Boat House near Ooty. Ooty Boat House is a different booking location, and Pykara Falls has a separate approach. Check each destination, entry arrangement and opening status independently.'],
 ['Are speed boats available every day?','No. The 30 October 2026 Madras High Court order banned petrol/diesel motorboats, speed boats and jet skis at Pykara Lake. Only rowing boats, pedal boats and low-power electric boats may operate under conditions set by the authorities, and even those are subject to TTDC ticketing and daily capacity. This guide does not confirm a sailing for a particular day; check TTDC availability, suitable life jackets, capacity, weather cancellation and refunds before paying.'],
 ['How far is Pykara Lake from Ooty?','The Nilgiris district tourism page describes the lake as about 21 km from Ooty on the Ooty–Mysore road. That is an approximate destination distance, not a gate-to-gate route or journey-time guarantee. Check your route, the boat house entrance and return transport.'],
];
const faqs=[...faqsTa,...faqsEn];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<BaseLayout
  {title}
  {description}
  image="/images/pykara-social.jpg"
  imageAlt="Historical view from a boat on Pykara Lake toward the shore in 2016, by KARTY JazZ; cropped for this guide"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(touristSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>

  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#0d2e26]/65 text-white backdrop-blur-xl">
    <div class="container-shell flex h-18 items-center justify-between gap-5 py-3">
      <a href="#top" class="flex items-center gap-3 font-extrabold">
        <img src="/brand/logo.svg" alt="பைக்காரா லோகோ" class="h-11 w-11" />
        <span class="hidden sm:block">பைக்காரா <span class="text-white/55">நீலகிரி</span></span>
      </a>
      <nav class="hidden gap-6 text-sm font-bold text-white/80 xl:flex" aria-label="முதன்மை வழிசெலுத்தல்">
        <a href="#guide" class="hover:text-white"><span class="ta-only">வழிகாட்டி</span><span class="en-only">Guide</span></a>
        <a href="#about" class="hover:text-white"><span class="ta-only">அறிமுகம்</span><span class="en-only">About</span></a>
        <a href="#boating" class="hover:text-white"><span class="ta-only">படகு</span><span class="en-only">Boating</span></a>
        <a href="#plan" class="hover:text-white"><span class="ta-only">பயணத் திட்டம்</span><span class="en-only">Plan</span></a>
        <a href="#map" class="hover:text-white"><span class="ta-only">வரைபடம்</span><span class="en-only">Map</span></a>
        <a href="#reviews" class="hover:text-white"><span class="ta-only">மதிப்புரைகள்</span><span class="en-only">Reviews</span></a>
        <a href="#faq" class="hover:text-white"><span class="ta-only">கேள்விகள்</span><span class="en-only">FAQ</span></a>
        <a href="#guides" class="hover:text-white"><span class="ta-only">வழிகாட்டிகள்</span><span class="en-only">Guides</span></a>
      </nav>
      <details class="compact-nav xl:hidden"><summary><span class="ta-only">மெனு ▾</span><span class="en-only">Menu ▾</span></summary><nav aria-label="Mobile navigation">{[['Guide','#guide'],['Boating','#boating'],['Plan','#plan'],['Map','#map'],['Reviews','#reviews'],['FAQ','#faq'],['Guides','#guides'],['Sources','#sources']].map(([label,href])=><a href={href}>{label}</a>)}</nav></details>
      <div class="flex items-center gap-2">
        <button type="button" data-lang-toggle aria-label="Switch language" class="lang-switch">
          <span class="ta-only">EN</span>
          <span class="en-only">தமிழ்</span>
        </button>
        <button
          type="button"
          data-pwa-install
          hidden
          class="rounded-full border border-white/25 px-4 py-2 text-sm font-bold"
        >
          <span class="ta-only">ஆப் ஆக நிறுவு</span>
          <span class="en-only">Install app</span>
        </button>
        <a class="rounded-full bg-white px-4 py-2 text-sm font-extrabold text-[#183f33]" href={ATTRACTION.mapsListingUrl} target="_blank" rel="noopener noreferrer"><span class="ta-only">வழி காண்க ↗</span><span class="en-only">Get directions ↗</span></a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="hero-photo relative isolate overflow-hidden text-white">
      <img
        src={ATTRACTION.heroImage} srcset="/images/pykara-from-boat-800.jpg 800w, /images/pykara-from-boat.jpg 1600w" sizes="100vw"
        alt="Pykara Lake shore seen from a boat in May 2016, photographed by KARTY JazZ; historical view"
        class="absolute inset-0 h-full w-full object-cover"
        width="1600"
        height="1067"
        loading="eager"
        fetchpriority="high"
      />
      <div class="container-shell relative z-10 flex min-h-[78vh] items-end pb-14 pt-32 md:items-center">
        <div class="max-w-3xl">
          <span class="pill mb-5 bg-white/12 text-white ring-1 ring-white/20">
            <span class="ta-only">நீலகிரியின் அமைதியான நீர்பரப்பு</span>
            <span class="en-only">The quiet waters of the Nilgiris</span>
          </span>
          <h1 class="font-serif text-[clamp(3.1rem,8vw,7.4rem)] font-semibold leading-[.88] tracking-[-.055em]">
            <span class="block ta-only">பைக்காரா<br /><span class="text-[#cfe6df]">ஏரி</span></span><span class="block en-only">Pykara Lake<br /><span class="text-[#cfe6df]">Boat House</span></span>
            <span class="mt-5 block font-sans text-[clamp(.95rem,2.1vw,1.3rem)] font-extrabold leading-snug tracking-normal text-white/85">
              {ATTRACTION.fullName} ({ATTRACTION.city}) · {ATTRACTION.stateProvince}, {ATTRACTION.country}
            </span>
          </h1>
          <p class="mt-6 max-w-2xl text-base leading-8 text-white/78 md:text-lg">
            <span class="ta-only">பைன் காடுகள், மெல்லிய பனி, அமைதியான நீர் மற்றும் TTDC படகு இல்லம் — ஊட்டியைத் தாண்டி நீலகிரியின் இயற்கையை மெதுவாக அனுபவிக்க ஒரு நாள் பயணம்.</span>
            <span class="en-only">Pine forests, soft mist, still water and the TTDC boat house — a slow day trip into the Nilgiris beyond Ooty.</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#plan" class="btn-primary btn-sun"><span class="ta-only">பயணத்தைத் திட்டமிடு ↓</span><span class="en-only">Plan your trip ↓</span></a>
            <button id="save-plan" class="btn-secondary"><span class="ta-only">இந்த திட்டத்தை சேமி</span><span class="en-only">Save this plan</span></button>
          </div>

          {/* Google 评分：页面展示 + 来源标注（不进 JSON-LD） */}
          <div class="mt-8">
            <RatingChip tone="dark" />
          </div>
          <p id="hero-photo-credit" class="mt-5 max-w-xl rounded-xl bg-[#10251f]/85 px-3 py-2 text-xs leading-6 text-white/90">புகைப்படம்: KARTY JazZ · 2016 · CC BY-SA 4.0 · <a href="#sources" class="underline">Source / changes</a></p>
        </div>
      </div>

    </section>

    <section class="relative z-20 -mt-5">
      <div class="container-shell grid gap-3 md:grid-cols-4">
        {[
          { k:['நேரம்','Hours'], v:['10:00–16:00 நீதிமன்ற நிர்ணயம்','10:00–16:00 court-set window'], n:['30/10 நீதிமன்ற உத்தரவு; டிக்கெட் நேரம் TTDC','30 Oct 2026 court order; ticket times with TTDC'] },
          { k:['நுழைவு','Entry'], v:['நடப்பு கட்டணம் உறுதி செய்யவும்','Check current admission'], n:['தற்போதைய விலை மாறலாம்','Current rate may vary'] },
          { k:['படகு','Boating'], v:['வகை / தேதி சரிபார்க்கவும்','Check type and date'], n:['படகு வகை/இருப்பிடத்தைப் பொறுத்தது','Depends on boat type / availability'] },
          { k:['அணுகல்','Access'], v:['முன்கூட்டியே கேளுங்கள்','Ask before travel'], n:['Maps குறிப்பு: அணுகக்கூடிய நுழைவு இல்லை','Maps reports no accessible entrance; not an audit'] }
        ].map(({k,v,n}) => (
          <div class="card p-5">
            <p class="eyebrow"><span class="ta-only">{k[0]}</span><span class="en-only">{k[1]}</span></p>
