untain railway'],['ooty-vs-pykara','ஊட்டி vs பைக்காரா','Ooty vs Pykara'],['things-to-do','செய்ய வேண்டியவை','Things to do'],['travel-tips','பயணக் குறிப்புகள்','Travel tips'],['trekking-trails','நடைப்பயணப் பாதைகள்','Trekking trails'],['monsoon-season','பருவமழை','Monsoon season']].map(([slug,ta,en])=>(<a href={`/${slug}/`} class="card p-5 hover:bg-white"><p class="font-extrabold"><span class="ta-only">{ta}</span><span class="en-only">{en}</span></p></a>))}</div></div></section>

